#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "ur5"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "ur5" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    custom rel isaac:physics:robotJoints
    custom rel isaac:physics:robotLinks

    over "Physics"
    {
        over "shoulder_pan_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "root_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "shoulder_lift_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "elbow_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "wrist_1_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "wrist_2_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "wrist_3_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "ee_fixed_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "mount_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint1" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint5" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint9" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint12" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint0" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint2" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint3" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint4" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint6" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint7" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint8" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint10" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint11" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint13" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint14" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint15" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }

    over "Geometry"
    {
        over "base_link" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "shoulder_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "upper_arm_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "forearm_link" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "wrist_1_link" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "wrist_2_link" (
                                prepend apiSchemas = ["IsaacLinkAPI"]
                            )
                            {
                                over "wrist_3_link" (
                                    prepend apiSchemas = ["IsaacLinkAPI"]
                                )
                                {
                                    over "ee_link" (
                                        prepend apiSchemas = ["IsaacLinkAPI"]
                                    )
                                    {
                                        over "palm_lower" (
                                            prepend apiSchemas = ["IsaacLinkAPI"]
                                        )
                                        {
                                            over "mcp_joint" (
                                                prepend apiSchemas = ["IsaacLinkAPI"]
                                            )
                                            {
                                                over "pip" (
                                                    prepend apiSchemas = ["IsaacLinkAPI"]
                                                )
                                                {
                                                    over "dip" (
                                                        prepend apiSchemas = ["IsaacLinkAPI"]
                                                    )
                                                    {
                                                        over "fingertip" (
                                                            prepend apiSchemas = ["IsaacLinkAPI"]
                                                        )
                                                        {
                                                            over "index_tip_head" (
                                                                prepend apiSchemas = ["IsaacSiteAPI"]
                                                            )
                                                            {
                                                            }
                                                        }
                                                    }
                                                }
                                            }

                                            over "mcp_joint_2" (
                                                prepend apiSchemas = ["IsaacLinkAPI"]
                                            )
                                            {
                                                over "pip_2" (
                                                    prepend apiSchemas = ["IsaacLinkAPI"]
                                                )
                                                {
                                                    over "dip_2" (
                                                        prepend apiSchemas = ["IsaacLinkAPI"]
                                                    )
                                                    {
                                                        over "fingertip_2" (
                                                            prepend apiSchemas = ["IsaacLinkAPI"]
                                                        )
                                                        {
                                                            over "middle_tip_head" (
                                                                prepend apiSchemas = ["IsaacSiteAPI"]
                                                            )
                                                            {
                                                            }
                                                        }
                                                    }
                                                }
                                            }

                                            over "mcp_joint_3" (
                                                prepend apiSchemas = ["IsaacLinkAPI"]
                                            )
                                            {
                                                over "pip_3" (
                                                    prepend apiSchemas = ["IsaacLinkAPI"]
                                                )
                                                {
                                                    over "dip_3" (
                                                        prepend apiSchemas = ["IsaacLinkAPI"]
                                                    )
                                                    {
                                                        over "fingertip_3" (
                                                            prepend apiSchemas = ["IsaacLinkAPI"]
                                                        )
                                                        {
                                                            over "ring_tip_head" (
                                                                prepend apiSchemas = ["IsaacSiteAPI"]
                                                            )
                                                            {
                                                            }
                                                        }
                                                    }
                                                }
                                            }

                                            over "thumb_temp_base" (
                                                prepend apiSchemas = ["IsaacLinkAPI"]
                                            )
                                            {
                                                over "thumb_pip" (
                                                    prepend apiSchemas = ["IsaacLinkAPI"]
                                                )
                                                {
                                                    over "thumb_dip" (
                                                        prepend apiSchemas = ["IsaacLinkAPI"]
                                                    )
                                                    {
                                                        over "thumb_fingertip" (
                                                            prepend apiSchemas = ["IsaacLinkAPI"]
                                                        )
                                                        {
                                                            over "thumb_tip_head" (
                                                                prepend apiSchemas = ["IsaacSiteAPI"]
                                                            )
                                                            {
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
