#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

def Scope "Materials"
{
    def Material "palm_lower_material"
    {
        color3f inputs:diffuseColor = (0.32314324, 0.019382361, 0.019382361)
        float inputs:metallic = 0
        float inputs:opacity = 1
        float inputs:roughness = 0.5
        token inputs:wrapMode = "repeat"
        token outputs:displacement (
            displayGroup = "Outputs"
        )
        prepend token outputs:displacement.connect = </Materials/palm_lower_material/PreviewSurface.outputs:displacement>
        token outputs:surface (
            displayGroup = "Outputs"
        )
        prepend token outputs:surface.connect = </Materials/palm_lower_material/PreviewSurface.outputs:surface>
        token outputs:volume (
            displayGroup = "Outputs"
        )

        def Shader "PreviewSurface" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdPreviewSurface"
            prepend color3f inputs:diffuseColor.connect = </Materials/palm_lower_material.inputs:diffuseColor>
            prepend float inputs:metallic.connect = </Materials/palm_lower_material.inputs:metallic>
            prepend float inputs:opacity.connect = </Materials/palm_lower_material.inputs:opacity>
            prepend float inputs:roughness.connect = </Materials/palm_lower_material.inputs:roughness>
            token outputs:displacement
            token outputs:surface
        }
    }

    def Material "mcp_joint_material"
    {
        color3f inputs:diffuseColor = (0.72305524, 0.72305524, 0.004024717)
        float inputs:metallic = 0
        float inputs:opacity = 1
        float inputs:roughness = 0.5
        token inputs:wrapMode = "repeat"
        token outputs:displacement (
            displayGroup = "Outputs"
        )
        prepend token outputs:displacement.connect = </Materials/mcp_joint_material/PreviewSurface.outputs:displacement>
        token outputs:surface (
            displayGroup = "Outputs"
        )
        prepend token outputs:surface.connect = </Materials/mcp_joint_material/PreviewSurface.outputs:surface>
        token outputs:volume (
            displayGroup = "Outputs"
        )

        def Shader "PreviewSurface" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdPreviewSurface"
            prepend color3f inputs:diffuseColor.connect = </Materials/mcp_joint_material.inputs:diffuseColor>
            prepend float inputs:metallic.connect = </Materials/mcp_joint_material.inputs:metallic>
            prepend float inputs:opacity.connect = </Materials/mcp_joint_material.inputs:opacity>
            prepend float inputs:roughness.connect = </Materials/mcp_joint_material.inputs:roughness>
            token outputs:displacement
            token outputs:surface
        }
    }

    def Material "pip_material"
    {
        color3f inputs:diffuseColor = (0.5209957, 0.5209957, 0.5209957)
        float inputs:metallic = 0
        float inputs:opacity = 1
        float inputs:roughness = 0.5
        token inputs:wrapMode = "repeat"
        token outputs:displacement (
            displayGroup = "Outputs"
        )
        prepend token outputs:displacement.connect = </Materials/pip_material/PreviewSurface.outputs:displacement>
        token outputs:surface (
            displayGroup = "Outputs"
        )
        prepend token outputs:surface.connect = </Materials/pip_material/PreviewSurface.outputs:surface>
        token outputs:volume (
            displayGroup = "Outputs"
        )

        def Shader "PreviewSurface" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdPreviewSurface"
            prepend color3f inputs:diffuseColor.connect = </Materials/pip_material.inputs:diffuseColor>
            prepend float inputs:metallic.connect = </Materials/pip_material.inputs:metallic>
            prepend float inputs:opacity.connect = </Materials/pip_material.inputs:opacity>
            prepend float inputs:roughness.connect = </Materials/pip_material.inputs:roughness>
            token outputs:displacement
            token outputs:surface
        }
    }
}

