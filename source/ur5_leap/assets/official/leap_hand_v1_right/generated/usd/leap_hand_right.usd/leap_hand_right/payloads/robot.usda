#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "onshape"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "onshape" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    custom rel isaac:physics:robotJoints
    custom rel isaac:physics:robotLinks

    over "Physics"
    {
        over "tn__1_" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "tn__5_" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "tn__9_" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "tn__12_" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "root_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "tn__0_" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "tn__2_" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "tn__3_" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "tn__4_" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "tn__6_" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "tn__7_" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "tn__8_" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "tn__10_" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "tn__11_" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "tn__13_" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "tn__14_" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "tn__15_" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }

    over "Geometry"
    {
        over "palm_lower" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "mcp_joint" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "pip" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "dip" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "fingertip" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                        }
                    }
                }
            }

            over "mcp_joint_2" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "pip_2" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "dip_2" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "fingertip_2" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                        }
                    }
                }
            }

            over "mcp_joint_3" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "pip_3" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "dip_3" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "fingertip_3" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                        }
                    }
                }
            }

            over "pip_4" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "thumb_pip" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "thumb_dip" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "thumb_fingertip" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                        }
                    }
                }
            }
        }
    }
}

