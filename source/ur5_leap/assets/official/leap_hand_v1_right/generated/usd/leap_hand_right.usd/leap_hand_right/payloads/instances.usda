#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

def Scope "Instances"
{
    def Xform "palm_lower" (
        prepend references = @./geometries.usd@</Geometries/palm_lower>
    )
    {
        over "palm_lower" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/palm_lower/VisualMaterials/palm_lower_material>
        }

        def Scope "VisualMaterials"
        {
            def Material "palm_lower_material" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/palm_lower_material>
            )
            {
            }
        }
    }

    def Xform "palm_lower_1" (
        prepend references = @./geometries.usd@</Geometries/palm_lower>
    )
    {
        over "palm_lower" (
            apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI"]
        )
        {
            token physics:approximation = "convexHull"
            token purpose = "guide"
        }
    }

