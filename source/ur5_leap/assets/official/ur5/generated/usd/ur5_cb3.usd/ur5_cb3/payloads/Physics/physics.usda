        )
        {
            float drive:angular:physics:damping = 0.017453292
            float drive:angular:physics:maxForce = 28
            float drive:angular:physics:stiffness = 1.7453293
            uniform token drive:angular:physics:type = "force"
            float newton:velocityLimit = 180
            uniform token physics:axis = "Z"
            custom rel physics:body0
            append rel physics:body0 = </ur5_cb3/Geometry/world/base_link/base_link_inertia/shoulder_link/upper_arm_link/forearm_link/wrist_1_link/wrist_2_link>
            custom rel physics:body1
            append rel physics:body1 = </ur5_cb3/Geometry/world/base_link/base_link_inertia/shoulder_link/upper_arm_link/forearm_link/wrist_1_link/wrist_2_link/wrist_3_link>
            point3f physics:localPos0 = (-1.110223e-16, 0.0823, -1.6880011e-11)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0.70710677, -0.70710677, 2.5363268e-17, 6.123234e-17)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -360
            float physics:upperLimit = 360
            custom float urdf:limit:effort = 28
        }

        def PhysicsFixedJoint "tn__base_linkbase_link_inertia_kc0"
        {
            custom rel physics:body0
            append rel physics:body0 = </ur5_cb3/Geometry/world/base_link>
            custom rel physics:body1
            append rel physics:body1 = </ur5_cb3/Geometry/world/base_link/base_link_inertia>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (6.123234e-17, 0, 0, 1)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }
    }
}

