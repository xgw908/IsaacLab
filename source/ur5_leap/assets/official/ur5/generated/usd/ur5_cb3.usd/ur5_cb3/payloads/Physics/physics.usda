            float newton:velocityLimit = 180
            uniform token physics:axis = "Z"
            custom rel physics:body0
            append rel physics:body0 = </ur5_cb3/Geometry/world/base_link/base_link_inertia/shoulder_link/upper_arm_link/forearm_link/wrist_1_link>
            custom rel physics:body1
            append rel physics:body1 = </ur5_cb3/Geometry/world/base_link/base_link_inertia/shoulder_link/upper_arm_link/forearm_link/wrist_1_link/wrist_2_link>
            point3f physics:localPos0 = (1.110223e-16, -0.09465, -1.9413054e-11)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0.70710677, 0.70710677, -2.5363267e-17, -4.3297803e-17)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -360
            float physics:upperLimit = 360
            custom float urdf:limit:effort = 28
        }

        def PhysicsRevoluteJoint "wrist_3_joint" (
