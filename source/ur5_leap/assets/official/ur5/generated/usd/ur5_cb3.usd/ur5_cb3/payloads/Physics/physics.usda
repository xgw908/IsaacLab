            uniform token drive:angular:physics:type = "force"
            float newton:velocityLimit = 180
            uniform token physics:axis = "Z"
            custom rel physics:body0
            append rel physics:body0 = </ur5_cb3/Geometry/world/base_link/base_link_inertia/shoulder_link/upper_arm_link>
            custom rel physics:body1
            append rel physics:body1 = </ur5_cb3/Geometry/world/base_link/base_link_inertia/shoulder_link/upper_arm_link/forearm_link>
            point3f physics:localPos0 = (-0.425, 0, 4.135903e-25)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -180
            float physics:upperLimit = 180
            custom float urdf:limit:effort = 150
        }

        def PhysicsRevoluteJoint "wrist_1_joint" (
            prepend apiSchemas = ["NewtonJointAPI", "PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 0.017453292
            float drive:angular:physics:maxForce = 28
            float drive:angular:physics:stiffness = 1.7453293
            uniform token drive:angular:physics:type = "force"
            float newton:velocityLimit = 180
            uniform token physics:axis = "Z"
            custom rel physics:body0
            append rel physics:body0 = </ur5_cb3/Geometry/world/base_link/base_link_inertia/shoulder_link/upper_arm_link/forearm_link>
            custom rel physics:body1
            append rel physics:body1 = </ur5_cb3/Geometry/world/base_link/base_link_inertia/shoulder_link/upper_arm_link/forearm_link/wrist_1_link>
            point3f physics:localPos0 = (-0.39225, 0, 0.10915)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -360
            float physics:upperLimit = 360
            custom float urdf:limit:effort = 28
        }

        def PhysicsRevoluteJoint "wrist_2_joint" (
            prepend apiSchemas = ["NewtonJointAPI", "PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 0.017453292
            float drive:angular:physics:maxForce = 28
