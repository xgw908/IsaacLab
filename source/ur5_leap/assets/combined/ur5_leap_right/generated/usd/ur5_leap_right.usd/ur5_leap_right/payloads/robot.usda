#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "ur5_cb3_leap_v1_right"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "ur5_cb3_leap_v1_right" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    custom rel isaac:physics:robotJoints
    custom rel isaac:physics:robotLinks

    over "Physics"
    {
        over "shoulder_pan_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "tn__base_linkbase_link_inertia_kc0" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "shoulder_lift_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "elbow_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "wrist_1_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "wrist_2_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "wrist_3_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "leap_joint_0" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "leap_joint_1" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "leap_joint_2" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "leap_joint_3" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "leap_joint_4" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "leap_joint_5" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "leap_joint_6" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "leap_joint_7" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "leap_joint_8" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "leap_joint_9" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "leap_joint_10" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "leap_joint_11" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "leap_joint_12" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "leap_joint_13" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "leap_joint_14" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "leap_joint_15" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "adapter_to_palm" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }

    over "Geometry"
    {
        over "base_link"
        {
            over "base_link_inertia" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "shoulder_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "upper_arm_link" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "forearm_link" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "wrist_1_link" (
                                prepend apiSchemas = ["IsaacLinkAPI"]
                            )
                            {
                                over "wrist_2_link" (
                                    prepend apiSchemas = ["IsaacLinkAPI"]
                                )
                                {
                                    over "wrist_3_link" (
                                        prepend apiSchemas = ["IsaacLinkAPI"]
                                    )
                                    {
                                        over "ft_frame" (
                                            prepend apiSchemas = ["IsaacSiteAPI"]
                                        )
                                        {
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

