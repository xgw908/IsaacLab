#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "ur5_cb3_leap_v1_right"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

